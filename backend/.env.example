# ==============================================================================
# AXIOM RAG - Backend Environment Configuration (.env)
# ==============================================================================

# 1. LLM Provider (Groq Cloud API Key)
# Free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Vector Database (Qdrant Cloud)
# Free cluster from: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east-4-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# 3. Relational Database (Neon Serverless PostgreSQL)
# Free database from: https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# 4. Authentication (JWT Secret Key)
# Generate via terminal: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_random_32_character_secret_key_here
